    "howler": "^2.2.4",
    "postprocessing": "^6.39.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "standardized-audio-context": "^25.3.77",
    "three": "^0.185.1"
  },
  "devDependencies": {
