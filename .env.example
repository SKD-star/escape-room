# =============================================================
#  AI POWERED ESCAPE ROOM — Environment Configuration
#  Copy this file to `.env` and fill in the values you have.
#  EVERY variable is optional except SECRET_KEY / JWT_SECRET_KEY
#  (generate those with:  python -c "import secrets;print(secrets.token_hex(32))")
#  The game runs fully offline with local fallbacks when AI /
#  cloud keys are absent.
# =============================================================

# --- Flask core -------------------------------------------------
FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
# Port the API server listens on
PORT=5000

# --- Database ---------------------------------------------------
# If MYSQL_HOST is empty the server falls back to SQLite (zero-setup dev mode).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=escape_room
MYSQL_USERNAME=
MYSQL_PASSWORD=

# --- AI (puzzles, hints, Librarian chatbot) ---------------------
# Any OpenAI-compatible provider. The game ships with a FREE OpenRouter key,
# so this is optional — without it the procedural generator is used.
#
#   Free key (no card):  https://openrouter.ai/keys   -> sk-or-v1-...
#   Paid OpenAI key:     https://platform.openai.com/api-keys -> sk-proj-...
#
# sk-or-... keys are auto-routed to OpenRouter's $0 model pool.
AI_API_KEY=
# Leave blank to use the built-in free model chain (recommended — OpenRouter
# rotates its free roster). Override with e.g. openai/gpt-oss-20b:free
AI_MODEL=
# Leave blank to infer from the key (openrouter.ai for sk-or-, else OpenAI).
AI_BASE_URL=
# Shown on OpenRouter's public app rankings.
AI_SITE_URL=http://localhost:5173
AI_SITE_NAME=AI Powered Escape Room

# Key compiled into the static browser build (Netlify). PUBLIC — anyone can
# read it in the JS bundle, so only ever use a free-tier, zero-spend key.
# Falls back to the key in client/src/ai/aiConfig.js when unset.
VITE_AI_KEY=

# --- Optional AI fallbacks --------------------------------------
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=

# --- Email (forgot password) ------------------------------------
# e.g. Gmail app password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- OAuth (optional social login) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloud storage (optional) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
